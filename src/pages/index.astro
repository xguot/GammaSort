---
import BaseLayout from "../layouts/BaseLayout.astro";
import TabNavigation from "../components/TabNavigation.astro";
import TopicCard from "../components/TopicCard.astro";
import dataJson from "../data/data.json";

const tabs = dataJson.categories.map((c) => ({
  id: c.id,
  label: c.label,
  count: c.topics.length,
}));

const totalArticles = dataJson.categories.reduce(
  (acc, c) => acc + c.topics.reduce((tAcc, t) => tAcc + t.articleCount, 0),
  0
);
---

<BaseLayout
  title="Home"
  description="GammaSort — Interactive topic modeling explorer of US and Chinese academic papers"
>
  <!-- Hero Section -->
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange/10 text-orange text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-orange animate-pulse"></span>
          Topic Modeling Explorer
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-navy tracking-tight leading-tight">
          GammaSort
        </h1>
        <p class="mt-3 text-base sm:text-lg text-body/80 leading-relaxed">
          Explore <strong class="text-navy font-semibold">{dataJson.meta.totalTopics} research topics</strong> and over <strong class="text-navy font-semibold">{totalArticles} papers</strong> extracted from US and Chinese academic literature.
          Topics are categorized into <span class="text-navy font-medium">Only US</span>, <span class="text-navy font-medium">Only China</span>, and <span class="text-navy font-medium">Both</span>. Articles within each topic are ranked by relevance probability score (<span class="font-mono text-orange font-semibold">γ</span>).
        </p>

        <!-- Quick Stats Pills -->
        <div class="mt-6 flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs">
          <div class="flex items-center gap-1.5 bg-gray-50 border border-gray-200/80 px-3 py-1.5 rounded-lg text-body/80">
            <span class="font-bold text-navy">{dataJson.meta.totalTopics}</span>
            <span class="text-body/60">Total Topics</span>
          </div>
          <div class="flex items-center gap-1.5 bg-gray-50 border border-gray-200/80 px-3 py-1.5 rounded-lg text-body/80">
            <span class="font-bold text-navy">{totalArticles}</span>
            <span class="text-body/60">Indexed Papers</span>
          </div>
          <div class="flex items-center gap-1.5 bg-gray-50 border border-gray-200/80 px-3 py-1.5 rounded-lg text-body/80">
            <span class="font-bold text-navy">3</span>
            <span class="text-body/60">Corpora (US · CN · Joint)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Methodology Section -->
  <section id="methodology" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white rounded-xl border border-gray-200 p-6 hover:border-orange/30 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-orange/10 flex items-center justify-center mb-4">
          <span class="text-orange text-sm font-bold">US</span>
        </div>
        <h3 class="text-sm font-semibold text-navy mb-2">Latent Dirichlet Allocation</h3>
        <p class="text-xs text-body/60 leading-relaxed">
          The <strong class="text-body/80">Only US</strong> corpus is modeled with <strong class="text-body/80">LDA</strong>, an unsupervised generative probabilistic model that discovers latent thematic structures in large document collections. Each document is treated as a mixture of topics, and each topic is a distribution over words.
        </p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-6 hover:border-orange/30 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-orange/10 flex items-center justify-center mb-4">
          <span class="text-orange text-sm font-bold">CN</span>
        </div>
        <h3 class="text-sm font-semibold text-navy mb-2">Latent Dirichlet Allocation</h3>
        <p class="text-xs text-body/60 leading-relaxed">
          The <strong class="text-body/80">Only China</strong> corpus is also modeled with <strong class="text-body/80">LDA</strong>, applying the same topic modeling framework to Chinese-language academic literature for symmetric comparison with the US corpus.
        </p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-6 hover:border-orange/30 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-orange/10 flex items-center justify-center mb-4">
          <span class="text-orange text-sm font-bold">US+CN</span>
        </div>
        <h3 class="text-sm font-semibold text-navy mb-2">Structural Topic Model</h3>
        <p class="text-xs text-body/60 leading-relaxed">
          The <strong class="text-body/80">Both US &amp; China</strong> joint corpus is modeled with <strong class="text-body/80">STM</strong>, which extends topic modeling by incorporating document-level metadata — here, country of origin — as covariates. This allows the model to estimate how topic prevalence and content vary between the US and Chinese academic contexts.
        </p>
      </div>
    </div>
  </section>

  <!-- Explorer Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Sticky Navigation & Search Header -->
    <div class="sticky top-16 z-30 -mx-4 sm:-mx-6 lg:-mx-8 bg-offwhite/95 backdrop-blur-sm px-4 sm:px-6 lg:px-8 pb-4 pt-2 border-b border-gray-200/60 shadow-xs">
      <TabNavigation tabs={tabs} activeTab="only-us" />

      <!-- Interactive Controls Toolbar -->
      <!-- Interactive Controls Toolbar -->
      <div class="mt-3.5 bg-white p-2.5 sm:p-3 rounded-xl border border-gray-200 shadow-2xs space-y-2.5">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <!-- Live Search Input -->
          <div class="relative flex-1 min-w-[240px]">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="topic-search-input"
              placeholder="Search topics, keywords, papers, abstracts, or years..."
              class="w-full pl-9 pr-16 py-2 bg-gray-50 hover:bg-gray-100/70 focus:bg-white text-sm text-navy placeholder-gray-400 rounded-lg border border-transparent focus:border-orange focus:outline-none focus:ring-2 focus:ring-orange/20 transition-all"
              autocomplete="off"
            />
            <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center gap-1">
              <button
                type="button"
                id="clear-search-btn"
                class="text-gray-400 hover:text-navy hidden p-1 cursor-pointer"
                aria-label="Clear search"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
              <kbd
                id="search-shortcut-hint"
                class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono font-semibold text-gray-400 bg-white border border-gray-200 rounded shadow-2xs pointer-events-none"
                title="Press / or ⌘K to search"
              >
                /
              </kbd>
            </div>
          </div>

          <!-- Action Toolbar (Expand All / Sort) -->
          <div class="flex items-center gap-2 shrink-0 justify-between sm:justify-end">
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="expand-all-btn"
                class="px-2.5 py-1.5 text-xs font-semibold text-body/70 hover:text-navy hover:bg-gray-100 rounded-lg transition-colors cursor-pointer flex items-center gap-1 border border-gray-200"
                title="Expand all topic accordions in current tab"
              >
                <svg class="w-3.5 h-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 13l-7 7-7-7m14-8l-7 7-7-7" />
                </svg>
                <span>Expand All</span>
              </button>
              <button
                type="button"
                id="collapse-all-btn"
                class="px-2.5 py-1.5 text-xs font-semibold text-body/70 hover:text-navy hover:bg-gray-100 rounded-lg transition-colors cursor-pointer flex items-center gap-1 border border-gray-200"
                title="Collapse all topic accordions in current tab"
              >
                <svg class="w-3.5 h-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7-7 7 7M5 19l7-7 7 7" />
                </svg>
                <span>Collapse All</span>
              </button>
            </div>

            <!-- Sort Selector -->
            <div class="flex items-center gap-1.5 pl-2 border-l border-gray-200">
              <label for="sort-select" class="text-xs text-body/50 hidden md:inline">Sort:</label>
              <select
                id="sort-select"
                class="text-xs font-medium text-body/80 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-orange/20 cursor-pointer"
              >
                <option value="alpha">A → Z</option>
                <option value="count-desc">Most Papers</option>
                <option value="gamma-desc">Top γ Score</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Quick Filter Chips Row -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-0.5 text-xs">
          <span class="text-body/50 text-[11px] font-medium shrink-0 mr-1 hidden sm:inline">Quick Filters:</span>
          <button
            type="button"
            data-filter-chip="all"
            class="filter-chip px-2.5 py-1 rounded-full font-medium transition-all cursor-pointer bg-navy text-white shadow-2xs"
          >
            All Papers
          </button>
          <button
            type="button"
            data-filter-chip="high-gamma"
            class="filter-chip px-2.5 py-1 rounded-full font-medium transition-all cursor-pointer bg-gray-100 text-body/70 hover:bg-gray-200"
          >
            High Relevance (γ ≥ 0.9)
          </button>
          <button
            type="button"
            data-filter-chip="2020-plus"
            class="filter-chip px-2.5 py-1 rounded-full font-medium transition-all cursor-pointer bg-gray-100 text-body/70 hover:bg-gray-200"
          >
            Recent (2020+)
          </button>
          <button
            type="button"
            data-filter-chip="2015-2019"
            class="filter-chip px-2.5 py-1 rounded-full font-medium transition-all cursor-pointer bg-gray-100 text-body/70 hover:bg-gray-200"
          >
            2015–2019
          </button>
          <button
            type="button"
            data-filter-chip="pre-2015"
            class="filter-chip px-2.5 py-1 rounded-full font-medium transition-all cursor-pointer bg-gray-100 text-body/70 hover:bg-gray-200"
          >
            Pre-2015
          </button>
        </div>
      </div>
    </div>

    <!-- Active Search Filter Banner -->
    <div id="search-status-bar" class="mt-4 mb-2 flex items-center justify-between text-xs text-body/60 px-1 hidden">
      <p id="search-status-text">Showing matching topics</p>
      <button type="button" id="reset-filter-link" class="text-orange hover:underline cursor-pointer font-medium">
        Reset search
      </button>
    </div>

    <!-- Topic Panels per Category -->
    <div class="mt-6">
      {dataJson.categories.map((category) => (
        <div
          id={`category-panel-${category.id}`}
          data-category={category.id}
          class="category-panel space-y-3"
          style={category.id !== "only-us" ? "display:none" : ""}
          role="tabpanel"
          aria-labelledby={`tab-btn-${category.id}`}
        >
          {category.topics.length === 0 ? (
            <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
              <p class="text-sm text-body/60 font-medium">No topics found in this category.</p>
            </div>
          ) : (
            <div class="topics-container space-y-3">
              {category.topics.map((topic, idx) => (
                <TopicCard topic={topic} index={idx} categoryId={category.id} />
              ))}
            </div>
          )}

          <!-- No results empty state (for search filtering) -->
          <div class="no-search-results hidden bg-white rounded-xl border border-gray-200 p-10 text-center">
            <div class="w-12 h-12 rounded-full bg-orange/10 text-orange flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-navy mb-1">No matching topics or articles</h3>
            <p class="text-xs text-body/60 max-w-sm mx-auto mb-4">
              We couldn't find any results matching your search terms or filters in this category.
            </p>
            <button
              type="button"
              class="clear-search-trigger px-4 py-2 bg-navy text-white text-xs font-semibold rounded-lg hover:bg-orange transition-colors cursor-pointer"
            >
              Clear Filters
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // State
  let currentTabId = "only-us";
  let searchQuery = "";
  let sortMode = "alpha";
  let activeFilterChip = "all";

  const categoryPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const searchInput = document.getElementById("topic-search-input") as HTMLInputElement | null;
  const clearSearchBtn = document.getElementById("clear-search-btn");
  const searchStatusBar = document.getElementById("search-status-bar");
  const searchStatusText = document.getElementById("search-status-text");
  const resetFilterLink = document.getElementById("reset-filter-link");
  const expandAllBtn = document.getElementById("expand-all-btn");
  const collapseAllBtn = document.getElementById("collapse-all-btn");
  const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
  const filterChips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter-chip]"));

  function showCategory(tabId: string) {
    currentTabId = tabId;
    categoryPanels.forEach((panel) => {
      const isTarget = panel.dataset.category === tabId;
      panel.style.display = isTarget ? "" : "none";
    });

    tabButtons.forEach((btn) => {
      const isActive = btn.dataset.tab === tabId;
      btn.setAttribute("aria-selected", String(isActive));
      btn.setAttribute("tabindex", isActive ? "0" : "-1");
      const countBadge = btn.querySelector<HTMLElement>("[data-tab-count]");

      if (isActive) {
        btn.classList.add("border-orange", "text-orange", "bg-orange/5");
        btn.classList.remove("border-transparent", "text-body/60", "hover:text-navy", "hover:bg-gray-50");
        if (countBadge) {
          countBadge.classList.add("bg-orange", "text-white");
          countBadge.classList.remove("bg-gray-100", "text-body/60");
        }
      } else {
        btn.classList.remove("border-orange", "text-orange", "bg-orange/5");
        btn.classList.add("border-transparent", "text-body/60", "hover:text-navy", "hover:bg-gray-50");
        if (countBadge) {
          countBadge.classList.remove("bg-orange", "text-white");
          countBadge.classList.add("bg-gray-100", "text-body/60");
        }
      }
    });

    applyFiltersAndSorting();
  }

  function matchesChipFilter(card: HTMLElement): boolean {
    if (activeFilterChip === "all") return true;

    if (activeFilterChip === "high-gamma") {
      return card.dataset.hasHighGamma === "true";
    }

    const yearsStr = card.dataset.years || "";
    const years = yearsStr.split(",").map((y) => parseInt(y, 10)).filter((n) => !isNaN(n));

    if (activeFilterChip === "2020-plus") {
      return years.some((y) => y >= 2020);
    }
    if (activeFilterChip === "2015-2019") {
      return years.some((y) => y >= 2015 && y <= 2019);
    }
    if (activeFilterChip === "pre-2015") {
      return years.some((y) => y < 2015);
    }

    return true;
  }

  function applyFiltersAndSorting() {
    const activePanel = categoryPanels.find((p) => p.dataset.category === currentTabId);
    if (!activePanel) return;

    const cardsContainer = activePanel.querySelector<HTMLElement>(".topics-container");
    const noResultsElem = activePanel.querySelector<HTMLElement>(".no-search-results");
    if (!cardsContainer) return;

    const cards = Array.from(cardsContainer.querySelectorAll<HTMLElement>("[data-topic-card]"));
    const query = searchQuery.trim().toLowerCase();

    let visibleCount = 0;

    cards.forEach((card) => {
      const searchText = card.dataset.searchText || "";
      const matchesSearch = !query || searchText.includes(query);
      const matchesChip = matchesChipFilter(card);
      const isVisible = matchesSearch && matchesChip;

      card.style.display = isVisible ? "" : "none";
      if (isVisible) visibleCount++;
    });

    // Handle empty search result state
    if (noResultsElem) {
      if (visibleCount === 0 && cards.length > 0) {
        noResultsElem.classList.remove("hidden");
        cardsContainer.classList.add("hidden");
      } else {
        noResultsElem.classList.add("hidden");
        cardsContainer.classList.remove("hidden");
      }
    }

    // Update status bar
    const isFiltered = Boolean(query || activeFilterChip !== "all");
    if (isFiltered) {
      searchStatusBar?.classList.remove("hidden");
      if (searchStatusText) {
        searchStatusText.textContent = `Found ${visibleCount} topic${visibleCount !== 1 ? "s" : ""} matching your active filters in this category`;
      }
    } else {
      searchStatusBar?.classList.add("hidden");
    }

    if (query) {
      clearSearchBtn?.classList.remove("hidden");
    } else {
      clearSearchBtn?.classList.add("hidden");
    }

    // Sort cards in DOM
    sortCards(cardsContainer, cards);
  }

  function sortCards(container: HTMLElement, cards: HTMLElement[]) {
    cards.sort((a, b) => {
      if (sortMode === "count-desc") {
        const countA = Number(a.dataset.articleCount || 0);
        const countB = Number(b.dataset.articleCount || 0);
        return countB - countA;
      } else if (sortMode === "gamma-desc") {
        const gammaA = Number(a.dataset.maxGamma || 0);
        const gammaB = Number(b.dataset.maxGamma || 0);
        return gammaB - gammaA;
      } else {
        // Alphabetical A-Z
        const labelA = a.dataset.topicLabel || "";
        const labelB = b.dataset.topicLabel || "";
        return labelA.localeCompare(labelB);
      }
    });

    cards.forEach((card) => container.appendChild(card));
  }

  // Filter Chips Click
  filterChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const chipType = chip.dataset.filterChip || "all";
      activeFilterChip = chipType;

      filterChips.forEach((c) => {
        const isActive = c.dataset.filterChip === chipType;
        if (isActive) {
          c.classList.add("bg-navy", "text-white", "shadow-2xs");
          c.classList.remove("bg-gray-100", "text-body/70", "hover:bg-gray-200");
        } else {
          c.classList.remove("bg-navy", "text-white", "shadow-2xs");
          c.classList.add("bg-gray-100", "text-body/70", "hover:bg-gray-200");
        }
      });

      applyFiltersAndSorting();
    });
  });

  // Event Listeners
  window.addEventListener("tab-change", ((e: CustomEvent) => {
    showCategory(e.detail.tabId);
  }) as EventListener);

  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFiltersAndSorting();
  });

  // Global Keyboard Shortcuts
  window.addEventListener("keydown", (e) => {
    // Focus search on '/' or 'Cmd+K' / 'Ctrl+K'
    if (
      (e.key === "/" && document.activeElement !== searchInput && !["INPUT", "TEXTAREA", "SELECT"].includes((document.activeElement as HTMLElement)?.tagName)) ||
      ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")
    ) {
      e.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    } else if (e.key === "Escape" && document.activeElement === searchInput) {
      if (searchInput?.value) {
        clearSearch();
      } else {
        searchInput?.blur();
      }
    }
  });

  function resetAllFilters() {
    searchQuery = "";
    if (searchInput) searchInput.value = "";
    activeFilterChip = "all";
    filterChips.forEach((c) => {
      const isActive = c.dataset.filterChip === "all";
      if (isActive) {
        c.classList.add("bg-navy", "text-white", "shadow-2xs");
        c.classList.remove("bg-gray-100", "text-body/70", "hover:bg-gray-200");
      } else {
        c.classList.remove("bg-navy", "text-white", "shadow-2xs");
        c.classList.add("bg-gray-100", "text-body/70", "hover:bg-gray-200");
      }
    });
    applyFiltersAndSorting();
  }

  function clearSearch() {
    searchQuery = "";
    if (searchInput) searchInput.value = "";
    applyFiltersAndSorting();
    searchInput?.focus();
  }

  clearSearchBtn?.addEventListener("click", clearSearch);
  resetFilterLink?.addEventListener("click", resetAllFilters);

  document.querySelectorAll(".clear-search-trigger").forEach((btn) => {
    btn.addEventListener("click", resetAllFilters);
  });

  sortSelect?.addEventListener("change", (e) => {
    sortMode = (e.target as HTMLSelectElement).value;
    applyFiltersAndSorting();
  });

  // Expand / Collapse All
  expandAllBtn?.addEventListener("click", () => {
    const activePanel = categoryPanels.find((p) => p.dataset.category === currentTabId);
    if (!activePanel) return;

    activePanel.querySelectorAll<HTMLElement>("[data-topic-card]").forEach((card) => {
      if (card.style.display === "none") return;
      const btn = card.querySelector<HTMLButtonElement>("[data-accordion-trigger]");
      const panel = card.querySelector<HTMLElement>("[data-accordion-panel]");
      const chevron = card.querySelector<SVGElement>("[data-accordion-chevron]");

      if (panel && panel.classList.contains("hidden")) {
        panel.classList.remove("hidden");
        btn?.setAttribute("aria-expanded", "true");
        chevron?.classList.add("rotate-180");
      }
    });
  });

  collapseAllBtn?.addEventListener("click", () => {
    const activePanel = categoryPanels.find((p) => p.dataset.category === currentTabId);
    if (!activePanel) return;

    activePanel.querySelectorAll<HTMLElement>("[data-topic-card]").forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>("[data-accordion-trigger]");
      const panel = card.querySelector<HTMLElement>("[data-accordion-panel]");
      const chevron = card.querySelector<SVGElement>("[data-accordion-chevron]");

      if (panel && !panel.classList.contains("hidden")) {
        panel.classList.add("hidden");
        btn?.setAttribute("aria-expanded", "false");
        chevron?.classList.remove("rotate-180");
      }
    });
  });

  // Handle URL hash on initial load & popstate
  function initFromHash() {
    const hash = window.location.hash.replace("#", "");
    const validTabs = ["only-us", "only-china", "both"];
    if (hash && validTabs.includes(hash)) {
      showCategory(hash);
    } else {
      showCategory("only-us");
    }
  }

  window.addEventListener("hashchange", initFromHash);
  initFromHash();
</script>
